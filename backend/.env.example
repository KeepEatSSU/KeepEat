# ===== 로컬 개발 (docker compose --profile local up -d db) =====
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=

# ===== 운영(prod) DB — EC2 .env에만 채움. RDS 엔드포인트/계정 =====
PROD_DB_HOST=
PROD_DB_PORT=
PROD_DB_USER=
PROD_DB_PASSWORD=

# ===== 외부 API =====
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== JWT =====
JWT_SECRET_KEY=

# ===== Gmail SMTP =====
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== Firebase Admin SDK (base64 -w 0 firebase-service-key.json) =====
FIREBASE_KEY_BASE64=
