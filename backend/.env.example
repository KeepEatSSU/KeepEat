# 모든 환경은 동일한 런타임 변수명을 사용한다.
# 배포 워크플로는 DEMO_DB_*/PROD_DB_* GitHub Secrets를 아래 DB_* 이름으로 매핑한다.

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5433
DB_NAME=
DB_USER=
DB_PASSWORD=

# ===== 외부 API =====
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=

# ===== JWT =====
JWT_SECRET_KEY=

# ===== Gmail SMTP =====
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== Firebase Admin SDK =====
# 로컬에서는 classpath의 firebase-service-key.json을 사용할 수 있다.
# 배포 시 JSON을 base64로 인코딩해 FIREBASE_KEY_BASE64로 주입한다.
FIREBASE_KEY_PATH=
FIREBASE_KEY_BASE64=

# ===== HTTPS 직접 종료 (서버 배포 전용) =====
# 로컬 실행에는 필요 없다. 서버에서는 demo,tls 프로필과 함께 사용한다.
# SERVER_PORT=8443
# TLS_CERTIFICATE_PATH=file:/etc/letsencrypt/live/www.141.147.155.197.nip.io/fullchain.pem
# TLS_PRIVATE_KEY_PATH=file:/etc/letsencrypt/live/www.141.147.155.197.nip.io/privkey.pem
# HEALTHCHECK_URL=https://localhost:8443/actuator/health
