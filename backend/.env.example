# 로컬에서는 이 파일 구조를 복사한 .env 하나로 모든 실행 구성을 관리한다.

# ===== 로컬 PostgreSQL =====
DB_HOST=localhost
DB_PORT=5433
DB_NAME=
DB_USER=
DB_PASSWORD=

# ===== 데모 Supabase (Session pooler) =====
DEMO_DB_HOST=
DEMO_DB_PORT=5432
DEMO_DB_NAME=postgres
DEMO_DB_USER=
DEMO_DB_PASSWORD=

# ===== 운영 DB =====
# 로컬 실행에는 보통 채울 필요가 없고, 운영 배포에서는 GitHub Secrets가 주입한다.
PROD_DB_HOST=
PROD_DB_PORT=
PROD_DB_USER=
PROD_DB_PASSWORD=

# ===== 외부 API =====
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=

# ===== JWT =====
JWT_SECRET_KEY=

# ===== Gmail SMTP =====
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== Firebase Admin SDK =====
# 로컬에서는 classpath의 firebase-service-key.json을 사용할 수 있다.
# 배포 시 JSON을 base64로 인코딩해 FIREBASE_KEY_BASE64로 주입한다.
FIREBASE_KEY_PATH=
FIREBASE_KEY_BASE64=
