# 이 파일을 backend/.env로 복사한 뒤 실제 값으로 채운다.
# 모든 환경은 동일한 런타임 변수명을 사용하며, 실제 .env는 커밋하지 않는다.
# 배포 워크플로는 DEMO_DB_*/PROD_DB_* GitHub Secrets를 아래 DB_* 이름으로 매핑한다.

# ===== Spring 프로필 (선택) =====
# 로컬 JVM은 application.yml의 기본 프로필(local)을 사용한다.
# Compose의 app 서비스는 이 값이 없으면 prod, 데모 배포는 demo,tls를 사용한다.
# SPRING_PROFILES_ACTIVE=local

# ===== PostgreSQL =====
# 아래 host/port는 로컬 JVM + `docker compose --profile local ... db` 구성 기준이다.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=
DB_USER=
DB_PASSWORD=

# ===== 외부 API =====
OPENAI_API_KEY=
GEMINI_API_KEY=

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=

# ===== JWT =====
# HS256 기준 32바이트 이상의 충분히 긴 값을 사용한다.
JWT_SECRET_KEY=

# ===== Gmail SMTP =====
MAIL_USERNAME=
MAIL_PASSWORD=

# ===== Firebase 키 경로 (선택) =====
# FIREBASE_KEY_PATH=

# ===== 애플리케이션 튜닝 (선택, 미설정 시 오른쪽 기본값 사용) =====
# NOTIFICATION_RETENTION_DAYS=90
# PUSH_RECEIPT_CHECK_DELAY_MS=60000

# ===== 로컬 Prometheus 확인 (선택) =====
# 운영 공통값은 health만 노출한다. 로컬 모니터링을 사용할 때만 주석을 해제한다.
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus

# ===== 데모 Swagger 인증 (demo 프로필 전용) =====
# SWAGGER_USERNAME=
# SWAGGER_PASSWORD=  # 24자 이상
# SWAGGER_AUTH_MAX_FAILURES=5
# SWAGGER_AUTH_OBSERVATION_WINDOW=15m
# SWAGGER_AUTH_BLOCK_DURATION=15m

# ===== HTTPS 직접 종료 (서버 배포 전용) =====
# 로컬 실행에는 필요 없다. 서버에서는 demo,tls 프로필과 함께 사용한다.
# SERVER_PORT=8443
# TLS_CERTIFICATE_PATH=file:/etc/letsencrypt/live/www.141.147.155.197.nip.io/fullchain.pem
# TLS_PRIVATE_KEY_PATH=file:/etc/letsencrypt/live/www.141.147.155.197.nip.io/privkey.pem
# HEALTHCHECK_URL=https://localhost:8443/actuator/health
# JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseSerialGC
